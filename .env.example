# Local lightweight ES/Neo4j settings.
# Copy to .env if you want to override ports, images, or passwords.

ES_IMAGE=docker.elastic.co/elasticsearch/elasticsearch:8.19.0
ES_PORT=9200
ES_HEAP=512m
ES_INDEX=subtitle_segments

NEO4J_IMAGE=neo4j:2026.05.0
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=ragsearch123
NEO4J_HEAP=512m
NEO4J_PAGECACHE=256m

# MiMo LLM settings (for --llm / LLM 生成 mode)
MIMO_API_KEY=your-api-key-here
# MIMO_BASE_URL=https://api.xiaomimimo.com/v1
# MIMO_MODEL=mimo-v2.5-pro
